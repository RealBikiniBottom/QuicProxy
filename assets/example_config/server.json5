{
  "users": [
    { "username": "user", "password": "pwd" }
  ],
  "inbounds": {
    "shadowquic_inbound": {
      "type": "shadowquic",
      "address": "::",
      "port": 13431,
      "idle_timeout": 500,
      "mtu_discoveriy": false,
      "tls": {
        "enable_jls": true,
        "jls_username": "user",
        "jls_password": "pwd",
        "zero_rtt": true,
        "sni": "www.apple.com"
      }
    },
  },
  "outbounds": {
    "default_server": "direct",
    "servers": {
      "direct": {
        "type": "direct"
      },
      "speedtest": {
        "type": "speedtest"
      }
    }
  },
  "cache": {
    "all_cache": {
      "path": "server_cache.db"
    }
  },
  "router": {
    "default_mode": "rule",
    "rules": [
      {
        "domain": ["speedtest.quicproxy.internal"],
        "outbound": "speedtest"
      }
    ]
  },
  "dns": {
    "default_server": "local_dns",
    "servers": {
      "local_dns": {
        "type": "udp",
        // "address": "8.8.8.8",
        "address": "1.1.1.1",
        "port": 53,
        "timeout": 10,
        "outbound": "direct",
        "strategy": "ipv4_only",
        "cache": "all_cache"
      }
    }
  },
  "log": {
    "level": "debug",
    "color": true
  }
}
